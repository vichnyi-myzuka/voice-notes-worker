{
  "name": "voice-notes-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w apps/notes",
    "deploy": "npm run deploy -w apps/notes",
    "deploy:all": "npm run deploy --workspaces --if-present",
    "tail": "npm run tail -w apps/notes",
    "cost": "node --env-file=.env scripts/cost.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "oxlint": "^1.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
